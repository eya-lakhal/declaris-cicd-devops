pipeline {
    agent {
        node {
            label ''
            customWorkspace '/var/lib/jenkins/declaris/declaris-backend'
        }
    }
    tools {
        jdk 'JDK21'
    }
    environment {
        GIT_BRANCH = "main"
        GIT_CREDENTIALS_ID = "gitlab-git-credentials"
        GIT_URL = "https://gitlab.com/eyalakhal-group/declaris-backend.git"
        SONARQUBE_SERVER = "sonarqube-server"
    }
    stages {
        stage('Clean Workspace') {
            steps { deleteDir() }
        }
        stage('Clone') {
    steps {
        retry(3) {
            checkout([
                $class: 'GitSCM',
                branches: [[name: "*/${GIT_BRANCH}"]],
                userRemoteConfigs: [[
                    url: "${GIT_URL}",
                    credentialsId: "${GIT_CREDENTIALS_ID}"
                ]],
                extensions: [[$class: 'CloneOption', depth: 1, noTags: true, shallow: true, timeout: 30]]
            ])
        }
    }
}
        stage('Build Maven') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONARQUBE_SERVER}") {
                    sh 'mvn sonar:sonar'
                }
            }
        }
        stage('Trivy Security Scan') {
            steps {
                sh """
                    cd /var/lib/jenkins/declaris/declaris-deploy
                    podman build -t declaris-backend:scan-temp ../declaris-backend
                    rm -f /tmp/declaris-backend-scan.tar
                    podman save -o /tmp/declaris-backend-scan.tar localhost/declaris-backend:scan-temp
                    trivy image --input /tmp/declaris-backend-scan.tar --scanners vuln --vuln-type os --severity HIGH,CRITICAL --exit-code 0
                    rm -f /tmp/declaris-backend-scan.tar
                """
            }
        }
        stage('Validation du déploiement') {
            steps {
                script {
                    def changesText = getChangesText(currentBuild)

                    emailext(
                        subject: "Approbation requise : ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                        body: """Bonjour,

Un nouveau build backend est en attente de ton approbation pour déploiement.

Job : ${env.JOB_NAME}
Build : #${env.BUILD_NUMBER}

Changements détectés :
${changesText}

Pour approuver ou rejeter, connecte-toi à Jenkins et clique ici :
${env.BUILD_URL}input

Cordialement,
Jenkins
""",
                        to: 'eyalakhal9@gmail.com'
                    )

                    def decision = input(
                        message: 'Choisissez une action',
                        parameters: [
                            choice(
                                name: 'DECISION',
                                choices: ['APPROUVER', 'REFUSER'],
                                description: 'Autoriser le déploiement ?'
                            )
                        ]
                    )

                    if (decision == 'REFUSER') {
                        error("Déploiement refusé par l'utilisateur.")
                    }

                    echo "Déploiement approuvé."
                }
            }
        }
        stage('Deploy avec Compose') {
            steps {
                sh """
                    cd /var/lib/jenkins/declaris/declaris-deploy
                    git pull origin main
                    podman-compose stop declaris-backend || true
                    podman rm -f declarisbe || true
                    sudo pkill -9 -f "rootlessport" || true
                    sleep 5
                    podman-compose up -d --build declaris-backend
                """
            }
        }
    }
    post {
        success { echo "Backend déployé avec succès via docker-compose" }
        failure { echo "Échec du pipeline backend" }
    }
}

@NonCPS
def getChangesText(build) {
    def changesText = ""
    def changeLogSets = build.changeSets
    for (int i = 0; i < changeLogSets.size(); i++) {
        def entries = changeLogSets[i].items
        for (int j = 0; j < entries.length; j++) {
            def entry = entries[j]
            changesText += "- ${entry.author} : ${entry.msg}\n"
        }
    }
    if (!changesText?.trim()) {
        changesText = "Aucun changement de code détecté dans ce build (peut-être un redéclenchement manuel)."
    }
    return changesText
}